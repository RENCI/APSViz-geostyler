    "@types/node": "^22.0.0",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "buffer": "^6.0.3",
    "copyfiles": "^2.4.1",
    "extensionless": "^1.9.9",
    "jsdom": "^24.1.0",
    "less": "^4.9.0",
    "ol": "^9.2.4",
    "react": "^18.3.1",
