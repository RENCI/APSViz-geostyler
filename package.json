    "ol": ">=6.x",
    "react": ">=16.x",
    "react-dom": ">=16.x"
  },
  "funding": "https://opencollective.com/geostyler",
  "publishConfig": {
    "@renci:registry": "https://npm.pkg.github.com"
  },
  "overrides": {
